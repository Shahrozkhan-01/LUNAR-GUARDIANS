# =============================================
# LUNAR GUARDIANS — Junior Astronaut Mission Trainer
# .gitignore
# =============================================

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/.env
frontend/dist/
frontend/build/
frontend/.vite/

# --- Python / Backend ---
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
backend/.env
backend/*.egg-info/
backend/dist/
backend/build/
.Python

# --- Environment Variables (NEVER commit secrets) ---
.env
.env.local
.env.development
.env.production
.env.staging
.env.*.local

# --- Build Outputs ---
dist/
build/
out/

# --- IDE / Editor ---
.vscode/settings.json
.vscode/.ropeproject
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# --- OS Generated ---
.DS_Store
.DS_Store?
._*
.Spotlight-V*
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing ---
coverage/
.nyc_output/
*.lcov

# --- Temporary Files ---
*.tmp
*.temp
*.bak
*.orig
*.rej

# --- Package Locks (keep package-lock.json, ignore others) ---
yarn.lock
pnpm-lock.yaml

# --- Cache ---
.cache/
.npm/
.eslintcache
.stylelintcache
.parcel-cache/
