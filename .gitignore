# =============================================
# LUNAR GUARDIANS — Junior Astronaut Mission Trainer
# .gitignore
# =============================================

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/.env
frontend/dist/
frontend/build/
frontend/.vite/

# --- Python / Backend ---
backend/venv/
venv/
.venv/
backend/__pycache__/
backend/**/__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
backend/.env
backend/*.egg-info/
backend/dist/
backend/build/
.Python

# --- Environment Variables (NEVER commit secrets) ---
.env
.env.local
.env.development
.env.production
.env.staging
.env.*.local

# --- Build Outputs ---
dist/
build/
out/

# --- IDE / Editor ---
.vscode/settings.json
.vscode/.ropeproject
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# --- OS Generated ---
.DS_Store
.DS_Store?
._*
.Spotlight-V*
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing ---
coverage/
.nyc_output/
*.lcov
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage

# --- Temporary Files ---
*.tmp
*.temp
*.bak
*.orig
*.rej

# --- Package Locks (keep package-lock.json, ignore others) ---
yarn.lock
pnpm-lock.yaml

# --- Cache ---
.cache/
.npm/
.eslintcache
.stylelintcache
.parcel-cache/

# --- NASA data products ---
# Preserve local source/processed products, but do not stage them accidentally.
# Publish an explicitly approved subset only after terms and hosting are
# reviewed; keep metadata, scripts, summaries, and validation reports in Git.
datasets/raw/
datasets/processed/
datasets/github_compressed/

# This small source-derived sample and its provenance are shipped with the API.
!datasets/processed/
datasets/processed/*
!datasets/processed/lunar_environment/
datasets/processed/lunar_environment/*
!datasets/processed/lunar_environment/lola/
datasets/processed/lunar_environment/lola/*
!datasets/processed/lunar_environment/lola/ldem_16_preview.csv
!datasets/processed/lunar_environment/lola/ldem_16_preview_metadata.json

# These two products also exceed GitHub's 100 MB individual-file limit.
datasets/raw/lunar_environment/diviner/global_cumul_avg_cyl_80s70s_002.tab
datasets/processed/lunar_environment/lola/ldem_16_processed.npz
