vx1WQv3gHOLp","annotationValue":"co-author","comments":[],"termAccession":"http://purl.obolibrary.org/obo/MS_1002036","termSource":"MS"}]},{"@id":"","address":"","affiliation":"","comments":[{"name":"Study Person REF","value":""}],"email":"","fax":"","firstName":"Satish","lastName":"Mehta","midInitials":"K","phone":"","roles":[{"@id":"Gyd2rBtdV5f0pMYb7Vd9U4ste8H6vx1WQv3gHOLp","annotationValue":"co-author","comments":[],"termAccession":"http://purl.obolibrary.org/obo/MS_1002036","termSource":"MS"}]},{"@id":"","address":"","affiliation":"","comments":[{"name":"Study Person REF","value":""}],"email":"","fax":"","firstName":"Phillip","lastName":"Stafford","midInitials":"","phone":"","roles":[{"@id":"Gyd2rBtdV5f0pMYb7Vd9U4ste8H6vx1WQv3gHOLp","annotationValue":"co-author","comments":[],"termAccession":"http://purl.obolibrary.org/obo/MS_1002036","termSource":"MS"}]},{"@id":"","address":"","affiliation":"","comments":[{"name":"Study Person REF","value":""}],"email":"","fax":"","firstName":"Duane","lastName":"Pierson","midInitials":"","phone":"","roles":[{"@id":"Gyd2rBtdV5f0pMYb7Vd9U4ste8H6vx1WQv3gHOLp","annotationValue":"co-author","comments":[],"termAccession":"http://purl.obolibrary.org/obo/MS_1002036","termSource":"MS"}]},{"@id":"","address":"","affiliation":"The Biodesign Institute, Arizona State University","comments":[{"name":"Study Person REF","value":""}],"email":"","fax":"","firstName":"Cheryl","lastName":"Nickerson","midInitials":"A","phone":"","roles":[{"@id":"XaUXgZkFZ2nZqB2jkHmZbyxPwibz7V1jw9R9HKnp","annotationValue":"principal investigator","comments":[],"termAccession":"http://www.ebi.ac.uk/efo/EFO_0009736","termSource":"EFO"}]}],"description":"Astronauts are exposed to a unique combination of stressors during spaceflight, which leads to alterations in their physiology and potentially increases their susceptibility to infectious pathogens. Here we report the first microarray evaluation of any astronaut tissue sample, specifically whole blood, before and after spaceflight using an array comprising 234 well-characterized stress response genes. Differentially regulated genes included those important for DNA repair, oxidative stress, and protein folding/degradation. Microarrays comprising 234 well characterized stress-related genes were used to profile transcriptomic changes in six astronauts before and after short-duration spaceflight. Blood samples were collected for analysis from each eastronaut 10 days prior and 2-3 hours after return from spaceflight. Data submitted for platform GPL140 contain genes that have been pre-filtered by the analytical software to remove values of low certainty, resulting in missing values for some samples. Unfortunately, these original data are no longer available due to physical damage at Tulane University during hurricane Katrina, but the processed values were retained in redundant locations and these are submitted for upload to GEO.","dirty":false,"doi":"10.25966/qsf7-cr81","experimentPlatform":"","experiments":[],"factors":[{"@id":"rrAHixexWAdqOKNaj15Ezk66kWZSMcprcBRZfg1k","comments":[],"factorName":"Spaceflight","factorType":{"@id":"XJ2x9G5FYOhyGGbYDO0xkevuzcPxPnzdf1nFa9fv","annotationValue":"Space Flight","comments":[],"termAccession":"http://purl.bioontology.org/ontology/MESH/D013026","termSource":"MESH"}},{"@id":"rANZkGnBJ6jHN5eAzvW8ypGk7j2tvQ78C5dgPztj","comments":[],"factorName":"Sex","factorType":{"@id":"E1aZFyyTzHkRXSXHCGrA3aKYevfdJDXt0JaFXY4K","annotationValue":"sex","comments":[],"termAccession":"http://purl.obolibrary.org/obo/PATO_0000047","termSource":"EFO"}},{"@id":"qkbyi5cAJqaqdS88JensGCJ3xWmexCSKX1xatomj","comments":[],"factorName":"Time","factorType":{"@id":"XAhRiJDEesA1XpPC4VDsdxEaMfInwznF9qQavnyJ","annotationValue":"time","comments":[],"termAccession":"http://www.ebi.ac.uk/efo/EFO_0000721","termSource":"EFO"}}],"filesDisabled":null,"flightProgram":"","funding":"This work was funded by USRA Sponsor Award 09930-286-01 (017991-001).","identifiers":["GLDS-53"],"licenseIdentifier":"","licenseLink":"","licenseName":"","managingNasaCenter":"","metadataZip":"OSD-53_metadata_OSD-53-ISA.zip","missionEnd":"","missionLink":"","missionName":"","missionStart":"","modified":[{"file_name":"GLDS-53_metadata_E-GEOD-47126-ISA.zip","new_file_name":"OSD-53_metadata_OSD-53-ISA.zip"}],"modifiedDate":"19-Sep-2024","organisms":{"links":{"Homo sapiens":{"Homo sapiens":"http://purl.bioontology.org/ontology/NCBITAXON/9606"}},"ontologies":{"Homo sapiens":{"@id":"http://purl.bioontology.org/ontology/NCBITAXON/9606","prefLabel":"Homo sapiens"}}},"organizations":["genelab"],"payloads":[],"projectIdentifier":"","projectLink":"","projectTitle":"","projectType":"Spaceflight Study","protocols":[{"@id":"#140277497373216","comments":[],"components":[],"description":"Permission to collect blood from National Aeronautics and Space Administration (NASA) astronauts was obtained from the Johnson Space Center Committee for the Protection of Human Subjects. Consenting astronauts from several shuttle missions provided whole blood samples 10 days prior to shuttle launch (L-10) and several hours after return to earth (R+0). Whole blood was collected into a Vacutainer Blood collection tubes and then transferred into PAXgene tubes (PreAnalytiX, Hombrechtikon, CH), according to the manufacturer's instructions.","name":"P-GSE47126-3","parameters":[{"@id":"#140277956605888","parameterName":{"@id":"ZjmSSbPuCF9KW9S9qrQGc9mjnHs9TzHb1bMgnKcX","annotationValue":"duration","comments":[],"termAccession":"http://www.ebi.ac.uk/efo/EFO_0000433","termSource":"EFO"}}],"protocolType":{"@id":"9wkYyhlesDgqcPv3lZF4bVWWeMLlyf0rMUukXVtA","annotationValue":"P-GSE47126-3","comments":[],"termAccession":"","termSource":""},"uri":"","usage":["sample"],"version":""},{"@id":"#140277497373552","comments":[],"components":[],"description":"Total RNA was isolated from whole blood samples using the PAXgene Blood RNA Kit (PreAnalytiX, Hombrechtikon, CH), according to the manufacturer's instructions. Duplicate RNA samples were combined and DNase treated using a DNA-free kit (Ambion). RNA was quantitated by ultraviolet absorbance, concentrated by ethanol precipitation and re-suspended in deionized water (BD Biosciences Clontech) to yield a 4 ug sample of RNA for each astronaut at L-10 and R+0. RNA integrity was confirmed using denaturing Formaldehyde-Agarose gel electrophoresis.","name":"P-GSE47126-5","parameters":[{"@id":"#140277956604352","parameterName":{"@id":"3Hq6ViAPdhnUQVpmPN4g5qe1Sc2CIbQALaTc3jdF","annotationValue":"","comments":[],"termAccession":"","termSource":""}}],"protocolType":{"@id":"02rS6n6qabiBJ8156PtR5Nv5hqsXqLNgymzZBBvH","annotationValue":"nucleic acid extraction protocol","comments":[],"termAccession":"","termSource":""},"uri":"","usage":["a_OSD-53_transcription-profiling_dna-microarray_bd biosciences clontech.txt"],"version":""},{"@id":"#140277497373648","comments":[],"components":[],"description":"Total RNA was converted to 32P-labeled first-strand cDNA by reverse transcription. Reaction volumes were optimized for increased detection on the arrays as follows: 4 ug of total RNA was combined with 2 ul gene-specific CDS primer mix (BD Biosciences Clontech). A master mix was prepared at room temperature including 4 ul 5X Reaction Buffer, 2 ul 10X dNTP Mix (for dATP label), 5 ul [alpha-32P]dATP (10uCi/ul), and 1 ul 100mM DTT. Two microliters of MMLV Reverse Transcriptase was added to the master mix, and was combined with the RNA, primer mix. All incubations were performed according to the manufacturer's instructions. Labeled probes were purified using column chromatography (BD Biosciences Clontech).","name":"P-GSE47126-6","parameters":[{"@id":"#140277956605456","parameterName":{"@id":"3Hq6ViAPdhnUQVpmPN4g5qe1Sc2CIbQALaTc3jdF","annotationValue":"","comments":[],"termAccession":"","termSource":""}}],"protocolType":{"@id":"yFlDvSqdu4tePXxbbXosY8VmBNdT7MJz0eRCb6cG","annotationValue":"labelling protocol","comments":[],"termAccession":"","termSource":""},"uri":"","usage":["a_OSD-53_transcription-profiling_dna-microarray_bd biosciences clontech.txt"],"version":""},{"@id":"#140277956604928","comments":[],"components":[],"description":"","name":"library construction","parameters":[{"@id":"#140277956604880","parameterName":{"@id":"3Hq6ViAPdhnUQVpmPN4g5qe1Sc2CIbQALaTc3jdF","annotationValue":"","comments":[],"termAccession":"","termSource":""}}],"protocolType":{"@id":"UaxOdZkyXShYhcaqeJe6hWKD6RXeEVE41XioflQj","annotationValue":"library construction","comments":[],"termAccession":"","termSource":""},"uri":"","usage":["a_OSD-53_transcription-profiling_dna-microarray_bd biosciences clontech.txt"],"version":""},{"@id":"#140277956604064","comments":[],"components":[],"description":"Radioactive cDNA probes were hybridized to the microarrays at 68C overnight in ExpressHyb solution (BD Biosciences Clontech) and washed according to the manufacturer's instructions.","name":"P-GSE47126-7","parameters":[{"@id":"#140277956605024","parameterName":{"@id":"3Hq6ViAPdhnUQVpmPN4g5qe1Sc2CIbQALaTc3jdF","annotationValue":"","comments":[],"termAccession":"","termSource":""}}],"protocolType":{"@id":"QsGbGm9hcBzMXr3Hs7gwwlzEsitzNAWCzExM8iYR","annotationValue":"hybridization protocol","comments":[],"termAccession":"","termSource":""},"uri":"","usage":["a_OSD-53_transcription-profiling_dna-microarray_bd biosciences clontech.txt"],"version":""},{"@id":"#140277956606512","comments":[],"components":[],"description":"Arrays were exposed to a phosphoimager screen at room temperature for 3 days.","name":"P-GSE47126-8","parameters":[{"@id":"#140277956605552","parameterName":{"@id":"3Hq6ViAPdhnUQVpmPN4g5qe1Sc2CIbQALaTc3jdF","annotationValue":"","comments":[],"termAccession":"","termSource":""}}],"protocolType":{"@id":"Xl0xwtlgANyfScghPLbblWKZ7uc0wmnrtaBGOqfj","annotationValue":"array scanning protocol","comments":[],"termAccession":"","termSource":""},"uri":"","usage":["a_OSD-53_transcription-profiling_dna-microarray_bd biosciences clontech.txt"],"version":""},{"@id":"#140277956607952","comments":[],"components":[],"description":"For Flight samples: Arrays were analyzed using Atlas Image 2.0 software (Clontech Laboratories, Inc., Palo Alto, CA), according to the manufacturer's instructions. Arrays were normalized to the following housekeeping genes: ubiquitin C (UBC), liver glyceraldehyde 3-phosphate dehydrogenase (GAPDH), tubulin alpha 1 (TUBA1), and major histocompatability complex class I C (HLAC). After background subtraction for each array, the ratio of the post-flight adjusted intensity values (R+0) to the pre-flight adjusted intensity values (L-10) was calculated. Only genes with at least four data points pre-flight and post-flight were taken into consideration for data analysis. ID_REF equals  VALUE equals Background subtracted intensity and gene based normalization.  See Barrila et al. (2013) for details.\n\nFor Control (non-astronaut) sample: Arrays were analyzed using Atlas Image 2.0 software (Clontech Laboratories, Inc., Palo Alto, CA), according to the manufacturer's instructions. All astronaut arrays (L-10 and R+0) were normalized to an average of 5 control arrays from the whole blood of healthy non-astronaut control subjects. Arrays were normalized using the following housekeeping genes: ubiquitin C (UBC), liver glyceraldehyde 3-phosphate dehydrogenase (GAPDH), tubulin alpha 1 (TUBA1), and major histocompatability complex class I C (HLAC). After background subtraction for each array, the ratio of the post-flight adjusted intensity values (R+0) to the pre-flight adjusted intensity values (L-10) was calculated. Only genes for astronauts with at least four data points pre-flight and post-flight were taken into consideration for data analysis. ID_REF equals VALUE equals Background subtracted intensity and gene based normalization. See Barrila et al. (2013) for details","name":"P-GSE47126-1","parameters":[{"@id":"#140278196385056","parameterName":{"@id":"3Hq6ViAPdhnUQVpmPN4g5qe1Sc2CIbQALaTc3jdF","annotationValue":"","comments":[],"termAccession":"","termSource":""}}],"protocolType":{"@id":"Te9EKGL6P8x9G7F1mvzs8VP9bEiVW5IS8CjhePIx","annotationValue":"normalization data transformation protocol","comments":[],"termAccession":"","termSource":""},"uri":"","usage":["a_OSD-53_transcription-profiling_dna-microarray_bd biosciences clontech.txt"],"version":""}],"public":true,"publications":[{"authorList":"Jennifer Barrila, C Mark Ott, Carly LeBlanc, Satish K Mehta, Aur\u00e9lie Crabbe, Phillip Stafford, Duane L Pierson, Cheryl A Nickerson","comments":[],"doi":"10.1038/npjmgrav.2016.39","pubMedID":"28725744","status":{"@id":"LmdAvi3HYaAIgsfwpY1sWHGrDR5sHm3luQJDg1Ay","annotationValue":"published","comments":[],"termAccession":"http://www.ebi.ac.uk/efo/EFO_0001796","termSource":"EFO"},"title":"Spaceflight modulates gene expression in the whole blood of astronauts"}],"related_glds":"","releaseDate":"15-Oct-2013","removed":[{"bucket":"genelab-repo-prod","date_created":{"$date":1615568276732},"date_modified":{"$date":1615568276732},"file_name":"GLDS-53_microarray_A-GEOD-140.adf.txt","file_size":7158,"organization":"genelab","remote_path":"/Home/genelab-data/GLDS-53/microarray/GLDS-53_microarray_A-GEOD-140.adf.txt","remote_url":"/datamanager/file/Home/genelab-data/GLDS-53/microarray/GLDS-53_microarray_A-GEOD-140.adf.txt","resource_id":{"$oid":"59c440aae2d6f8d9822f2aa0"},"restricted":false,"s3_path":"genelab-data/GLDS-53/microarray/GLDS-53_microarray_A-GEOD-140.adf.txt","s3_version_id":"JvV5FU4VXiJxVzNYqvwGHnz5WwBnBI4o","study_id":"604b9d94cc48fe4c35b38c9e","subcategory":"Raw array data/Supplemental materials","version":2,"visible":true}],"restricted":false,"restrictedFilesDisabled":null,"samples":{"header":[{"encoded":false,"field":"Source Name","title":"Source Name","width":200},{"encoded":false,"field":"Sample Name","title":"Sample Name","width":200},{"encoded":false,"field":"Characteristics[Organism]","title":"Characteristics: Organism","width":200},{"encoded":false,"field":"Term Source REF"